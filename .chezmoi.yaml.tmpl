---
data:
  goreleaser:
    arch: '{{ .chezmoi.arch | replace "amd64" "x86_64" }}'
    os: '{{ .chezmoi.os | title }}'
  headless: {{ env "GITHUB_ACTIONS" | empty | not }}
  personal: {{ promptBoolOnce . "personal" "Enable personal profile" false }}
  sudo: '{{ if ne .chezmoi.username "root" -}} sudo {{ end }}'
  work: {{ promptBoolOnce . "work" "Enable work profile" false }}
github:
  refreshPeriod: '12h'
textconv:
  - pattern: '**/*.json'
    command: 'jq'
    args:
      - '--sort-keys'
      - '.'
  - pattern: '**/*.yaml'
    command: 'yq'
    args:
      - 'sort_keys(..)'

  # Diff the embedded release version of installed binaries rather than their
  # (huge, unreadable) contents. Go binaries expose a version in their build
  # info; anything else passes through and diffs normally. See the helper.
  - pattern: '**/.local/bin/*'
    command: '{{ .chezmoi.sourceDir }}/bin/textconv-goversion'
