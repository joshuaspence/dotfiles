background-opacity = 0.9
background-opacity-cells = true
bell-features = system,no-title,border
config-file = keybind.ghostty
gtk-custom-css = ghostty.css
gtk-wide-tabs = false
maximize = true
notify-on-command-finish = unfocused
notify-on-command-finish-action = bell,notify
notify-on-command-finish-after = 5m
selection-clear-on-copy = true
shell-integration-features =  no-cursor,ssh-env,ssh-terminfo,sudo,title
unfocused-split-fill = #000000
window-inherit-working-directory = false
window-new-tab-position = current
window-subtitle = working-directory

# Workaround for ghostty-org/ghostty#11404: a double click consults the link
# matcher before word selection, and the built-in path regex spans spaces, so
# double clicking either path of a `diff --git` line selects both. The cost is
# ctrl+click on URLs and paths; OSC 8 hyperlinks are unaffected.
link-url = false

# Workaround for ghostty-org/ghostty#8579.
#
# TODO: Check if this issue persists after upgrading to Ubuntu 26.04.
window-height = 9999
window-width = 9999
