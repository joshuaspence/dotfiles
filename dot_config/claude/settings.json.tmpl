{{- $config := dict
  "$schema" "https://json.schemastore.org/claude-code-settings.json"

  "autoConnectIde" true
  "autoMode" (dict
    "environment" (list "$defaults")
  )
  "enabledPlugins" (dict
    "claude-code-setup@claude-plugins-official" true
    "claude-md-management@claude-plugins-official" true
    "code-review@claude-plugins-official" true
    "commit-commands@claude-plugins-official" true
    "document-skills@anthropic-agent-skills" true
    "feature-dev@claude-plugins-official" true
    "frontend-design@claude-plugins-official" true
    "mattpocock-skills@claude-plugins-official" true
    "pr-review-toolkit@claude-plugins-official" true
    "ralph-loop@claude-plugins-official" true
    "session-report@claude-plugins-official" true
    "skill-creator@claude-plugins-official" true
    "terraform@claude-plugins-official" true
    "terraform@hashicorp" true
  )
  "env" (dict
    "CLAUDE_CODE_DEBUG_LOGS_DIR" (printf "%s/.local/state/claude/debug" .chezmoi.homeDir)
    "CLAUDE_CODE_NEW_INIT" "true"
    "CLAUDE_CODE_PLUGIN_CACHE_DIR" (printf "%s/.cache/claude/plugins" .chezmoi.homeDir)
    "DISABLE_FEEDBACK_COMMAND" "true"
    "DISABLE_UPDATES" "true"
    "FORCE_AUTOUPDATE_PLUGINS" "true"
  )
  "extraKnownMarketplaces" (dict
    "anthropic-agent-skills" (dict
      "source" (dict
        "source" "github"
        "repo" "anthropics/skills"
      )
    )
    "hashicorp" (dict
      "autoUpdate" true
      "source" (dict
        "source" "github"
        "repo" "hashicorp/agent-skills"
      )
    )
    "joshuaspence-claude-plugins" (dict
      "autoUpdate" true
      "source" (dict
        "source" "github"
        "repo" "joshuaspence/claude-plugins"
      )
    )
  )
  "fastModePerSessionOptIn" true
  "feedbackSurveyRate" 0
  "fileSuggestion" (dict
    "type" "command"
    "command" "bash ~/.config/claude/file-suggestion.sh"
  )
  "hooks" (dict)
  "outputStyle" "Explanatory"
  "permissions" (dict
    "allow" (list
      "Read(~/workspace)"
    )
    "ask" (list)
    "deny" (list
      "Read(./.env)"
    )
    "defaultMode" "auto"
  )
  "pluginConfigs" (dict)
  "sandbox" (dict)
  "showThinkingSummaries" true
  "skillOverrides" (dict)
  "skipAutoPermissionPrompt" true
  "skipDangerousModePermissionPrompt" true
  "skipWorkflowUsageWarning" true
  "statusLine" (dict
    "type" "command"
    "command" "claude-hud"
  )
  "theme" "auto"
  "tui" "fullscreen"
-}}

{{- if .personal -}}
{{- with (include "dot_config/claude/settings.personal.json" | fromJson) -}}
{{- $config = mergeOverwrite
  $config
  .
  (dict
    "autoMode" (dict
      "environment" (concat
        (dig "autoMode" "environment" (list) $config)
        (dig "autoMode" "environment" (list) .)
      | default (list))
    )
    "permissions" (dict
      "allow" (concat
        (dig "permissions" "allow" (list) $config)
        (dig "permissions" "allow" (list) .)
      | default (list))
      "ask" (concat
        (dig "permissions" "ask" (list) $config)
        (dig "permissions" "ask" (list) .)
      | default (list))
      "deny" (concat
        (dig "permissions" "deny" (list) $config)
        (dig "permissions" "deny" (list) .)
      | default (list))
    )
  )
-}}
{{- end -}}
{{- end -}}

{{- if .work -}}
{{- with (include "dot_config/claude/settings.work.json" | fromJson) -}}
{{- $config = mergeOverwrite
  $config
  .
  (dict
    "autoMode" (dict
      "environment" (concat
        (dig "autoMode" "environment" (list) $config)
        (dig "autoMode" "environment" (list) .)
      | default (list))
    )
    "permissions" (dict
      "allow" (concat
        (dig "permissions" "allow" (list) $config)
        (dig "permissions" "allow" (list) .)
      | default (list))
      "ask" (concat
        (dig "permissions" "ask" (list) $config)
        (dig "permissions" "ask" (list) .)
      | default (list))
      "deny" (concat
        (dig "permissions" "deny" (list) $config)
        (dig "permissions" "deny" (list) .)
      | default (list))
    )
  )
-}}
{{- end -}}
{{- end -}}

{{ $config | toPrettyJson }}
