{{- $config := dict
  "$schema" "https://json.schemastore.org/claude-code-settings.json"

  "autoConnectIde" true
  "autoMode" (dict
    "environment" (list "$defaults")
    "allow" (list "$defaults")
    "soft_deny" (list "$defaults")
    "hard_deny" (list "$defaults")
  )
  "enabledPlugins" (dict
    "claude-code-setup@claude-plugins-official" true
    "claude-md-management@claude-plugins-official" true
    "code-review@claude-plugins-official" true
    "commit-commands@claude-plugins-official" true
    "document-skills@anthropic-agent-skills" true
    "feature-dev@claude-plugins-official" true
    "frontend-design@claude-plugins-official" true
    "mattpocock-skills@claude-plugins-official" true
    "pr-review-toolkit@claude-plugins-official" true
    "ralph-loop@claude-plugins-official" true
    "session-report@claude-plugins-official" true
    "skill-creator@claude-plugins-official" true
    "terraform@claude-plugins-official" true
    "terraform@hashicorp" true
  )
  "env" (dict
    "CLAUDE_CODE_DEBUG_LOGS_DIR" (printf "%s/.local/state/claude/debug" .chezmoi.homeDir)
    "CLAUDE_CODE_NEW_INIT" "true"
    "CLAUDE_CODE_PLUGIN_CACHE_DIR" (printf "%s/.cache/claude/plugins" .chezmoi.homeDir)
    "DISABLE_FEEDBACK_COMMAND" "true"
    "DISABLE_UPDATES" "true"
    "FORCE_AUTOUPDATE_PLUGINS" "true"
  )
  "extraKnownMarketplaces" (dict
    "anthropic-agent-skills" (dict
      "source" (dict
        "source" "github"
        "repo" "anthropics/skills"
      )
    )
    "hashicorp" (dict
      "autoUpdate" true
      "source" (dict
        "source" "github"
        "repo" "hashicorp/agent-skills"
      )
    )
    "joshuaspence-claude-plugins" (dict
      "autoUpdate" true
      "source" (dict
        "source" "github"
        "repo" "joshuaspence/claude-plugins"
      )
    )
  )
  "fastModePerSessionOptIn" true
  "feedbackSurveyRate" 0
  "fileSuggestion" (dict
    "type" "command"
    "command" "bash ~/.config/claude/file-suggestion.sh"
  )
  "hooks" (dict)
  "outputStyle" "Explanatory"
  "permissions" (dict
    "allow" (list 
      "Read(~/workspace)"
    )
    "ask" (list)
    "deny" (list
      "Read(./.env)"
    )
    "additionalDirectories" (list)
    "defaultMode" "auto"
  )
  "pluginConfigs" (dict)
  "sandbox" (dict)
  "showThinkingSummaries" true
  "skillOverrides" (dict)
  "skipAutoPermissionPrompt" true
  "skipDangerousModePermissionPrompt" true
  "skipWorkflowUsageWarning" true
  "statusLine" (dict
    "type" "command"
    "command" "claude-hud"
  )
  "theme" "auto"
  "tui" "fullscreen"
-}}

{{- if .personal -}}
{{- $config = mergeOverwrite $config (dict
  "agentPushNotifEnabled" true
  "autoMode" (dict
    "environment" (concat
      (dig "autoMode" "environment" (list) $config)
      (list
        "Internal domains: *.joshuaspence.com, *.spence.au, *.spence.com.au, *.spence.family, *.spence.network"
        "Source control: github.com/joshuaspence/*"
      )
    )
  )
  "enabledPlugins" (dict
    "invoices@joshuaspence-claude-plugins" true
    "ndis@joshuaspence-claude-plugins" true
    "photos@joshuaspence-claude-plugins" true
    "pocketsmith@joshuaspence-claude-plugins" true
  )
  "inputNeededNotifEnabled" true
  "permissions" (dict
    "allow" (concat
      (dig "permissions" "allow" (list) $config)
      (list
        "mcp__pocketsmith__get_*"
        "mcp__pocketsmith__list_*"
        "Read(~/Dropbox/**)"
      )
    )
  )
  "voice" (dict
    "enabled" true
    "mode" "tap"
  )
) -}}
{{- end -}}

{{- if .work -}}
{{- $config = mergeOverwrite $config (dict
  "awsAuthRefresh" "aws sso login --sso-session anduril-govcom"
  "env" (dict
    "AWS_PROFILE" "claude"
    "AWS_REGION" "ap-southeast-2"
    "CLAUDE_CODE_USE_BEDROCK" "true"
    "DISABLE_TELEMETRY" "true"
  )
  "skipWebFetchPreflight" true
) -}}
{{- end -}}

{{ $config | toPrettyJson }}
