{{- $config := dict
  "$schema" "https://json.schemastore.org/claude-code-settings.json"

  "autoConnectIde" true
  "autoMode" (dict
    "environment" (list "$defaults")
    "allow" (list "$defaults")
    "soft_deny" (list "$defaults")
    "hard_deny" (list "$defaults")
  )
  "enabledPlugins" (dict
    "claude-code-setup@claude-plugins-official" true
    "claude-hud@claude-hud" true
    "claude-md-management@claude-plugins-official" true
    "code-review@claude-plugins-official" true
    "code-simplifier@claude-plugins-official" true
    "explanatory-output-style@claude-plugins-official" true
    "grill-me@mattpocock" true
    "hookify@claude-plugins-official" true
    "ralph-loop@claude-plugins-official" true
    "skill-creator@claude-plugins-official" true
  )
  "env" (dict
    "CLAUDE_CODE_DEBUG_LOGS_DIR" (printf "%s/.local/state/claude/debug" .chezmoi.homeDir)
    "CLAUDE_CODE_NEW_INIT" "true"
    "CLAUDE_CODE_PLUGIN_CACHE_DIR" (printf "%s/.cache/claude/plugins" .chezmoi.homeDir)
    "DISABLE_FEEDBACK_COMMAND" "true"
    "DISABLE_UPDATES" "true"
  )
  "extraKnownMarketplaces" (dict
    "anthropic-agent-skills" (dict
      "source" (dict
        "source" "git"
        "url" "https://github.com/anthropics/skills.git"
      )
    )
    "claude-hud" (dict
      "source" (dict
        "source" "github"
        "repo" "jarrodwatts/claude-hud"
      )
    )
    "joshuaspence-claude-plugins" (dict
      "source" (dict
        "source" "github"
        "repo" "joshuaspence/claude-plugins"
      )
    )
    "mattpocock" (dict
      "source" (dict
        "source" "settings"
        "name" "mattpocock"
        "plugins" (list
          (dict
            "name" "grill-me"
            "source" (dict
              "source" "github"
              "repo" "mattpocock/skills"
            )
          )
          (dict
            "name" "write-a-skill"
            "source" (dict
              "source" "github"
              "repo" "mattpocock/skills"
            )
          )
        )
      )
    )
  )
  "fastModePerSessionOptIn" true
  "feedbackSurveyRate" 0
  "fileSuggestion" (dict
    "type" "command"
    "command" "bash ~/.config/claude/file-suggestion.sh"
  )
  "hooks" (dict)
  "outputStyle" "default"
  "permissions" (dict
    "allow" (list 
      "Bash(jq:*)"
      "Read(~/workspace)"
    )
    "deny" (list
      "Read(./.env)"
    )
    "ask" (list)
    "defaultMode" "auto"
  )
  "pluginConfigs" (dict)
  "sandbox" (dict)
  "showThinkingSummaries" false
  "skillOverrides" (dict)
  "skipAutoPermissionPrompt" true
  "skipDangerousModePermissionPrompt" true
  "skipWorkflowUsageWarning" true
  "spellcheck" (dict
    "enabled" true
  )
  "statusLine" (dict
    "type" "command"
    "command" "bash ~/.config/claude/statusline.sh"
  )
  "theme" "auto"
  "tui" "fullscreen"
-}}

{{- if .personal -}}
{{- $config = mergeOverwrite $config (dict
  "agentPushNotifEnabled" true
  "autoMode" (dict
    "environment" (concat
      (dig "autoMode" "environment" (list) $config)
      (list
        "Internal domains: *.joshuaspence.com, *.spence.au, *.spence.com.au, *.spence.family, *.spence.network"
        "Source control: github.com/joshuaspence/*"
      )
    )
  )
  "enabledPlugins" (dict
    "invoices@joshuaspence-claude-plugins" true
    "ndis@joshuaspence-claude-plugins" true
    "photos@joshuaspence-claude-plugins" true
    "pocketsmith@joshuaspence-claude-plugins" true
  )
  "inputNeededNotifEnabled" true
  "permissions" (dict
    "allow" (concat
      (dig "permissions" "allow" (list) $config)
      (list
        "mcp__pocketsmith__get_*"
        "mcp__pocketsmith__list_*"
        "Read(~/Dropbox/**)"
      )
    )
  )
  "remoteControlAtStartup" false
  "voice" (dict
    "enabled" true
    "mode" "tap"
  )
) -}}
{{- end -}}

{{- if .work -}}
{{- $config = mergeOverwrite $config (dict
  "awsAuthRefresh" "aws sso login --sso-session anduril-govcom"
  "env" (dict
    "AWS_PROFILE" "claude"
    "AWS_REGION" "ap-southeast-2"
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC" "true"
    "CLAUDE_CODE_USE_BEDROCK" "true"
  )
  "extraKnownMarketplaces" (dict
    "anduril" (dict
      "source" (dict
        "source" "git"
        "url" "https://ghe.anduril.dev/anduril/claude-clams.git"
      )
    )
  )
  "skipWebFetchPreflight" true
) -}}
{{- end -}}

{{ $config | toPrettyJson }}
