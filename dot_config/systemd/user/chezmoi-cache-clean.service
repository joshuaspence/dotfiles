# chezmoi never evicts its download cache (twpayne/chezmoi#3149), so it grows unbounded as externals track new
# releases. The maintainer confirms the cache is safe to delete at any time; Chezmoi refetches what it needs on
# next run.

[Unit]
Description=Clear Chezmoi cache

[Service]
Type=oneshot
ExecStart=/usr/bin/rm --recursive --force %C/chezmoi
