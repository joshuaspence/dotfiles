#!/bin/bash

# Reduce a Go binary (piped on stdin) to its release version, so `chezmoi diff` shows a version delta rather than
# binary content.
#
# The version is read from the binary's embedded Go build info: an explicit `-X …Version=…` ldflag if present
# (goreleaser's convention), otherwise the main module version. Non-Go binaries have no build info, so their contents
# are passed through unchanged and diff normally.

set -o errexit
set -o nounset
set -o pipefail

readonly tmp=$(mktemp)
trap 'rm --force "${tmp}"' EXIT
cat >"${tmp}"

readonly version=$(
  { go version -m "${tmp}" 2>/dev/null || true; } | awk '
    /-ldflags=/ && /-X / && match($0, /[^ ]*[Vv]ersion=[vV]?[0-9]+\.[0-9]+\.[0-9]+/) {
      token = substr($0, RSTART, RLENGTH)
      sub(/.*=/, "", token)
      print token
      exit
    }
    $1 == "mod" { module = $3 }
    END { if (module != "" && module !~ /devel/) print module }
  ' | head --lines=1
)

if [[ -n "${version}" ]]; then
  echo "${version}"
else
  cat "${tmp}"
fi
