#!/bin/bash

# Reduce a Go binary (piped on stdin) to its release version, so `chezmoi diff` shows a version delta rather than
# binary content.
#
# The version is read from the binary's embedded Go build info: an explicit `-X …Version=…` ldflag if present
# (goreleaser's convention), otherwise the main module version. hen no version can be detected (e.g. a non-Go binary),
# the script fails with an error unless `--force` is given, in which case the input is passed through unchanged so it
# diffs normally.

set -o errexit
set -o nounset
set -o pipefail

FORCE=false
for arg in "$@"; do
  case "${arg}" in
    --force)
      FORCE=true
      ;;

    *)
      echo "${0##*/}: unknown argument: ${arg}" >&2
      exit 2
      ;;
  esac
done
readonly FORCE

readonly TMP=$(mktemp)
trap 'rm --force "${TMP}"' EXIT
cat >"${TMP}"

readonly VERSION=$(
  { go version -m "${TMP}" 2>/dev/null || true; } | awk '
    /-ldflags=/ && /-X / && match($0, /[^ ]*[Vv]ersion=[vV]?[0-9]+\.[0-9]+\.[0-9]+/) {
      token = substr($0, RSTART, RLENGTH)
      sub(/.*=/, "", token)
      print token
      exit
    }
    $1 == "mod" { module = $3 }
    END { if (module != "" && module !~ /devel/) print module }
  ' | head --lines=1
)

if [[ -n "${VERSION}" ]]; then
  echo "${VERSION}"
elif "${FORCE}"; then
  cat "${TMP}"
else
  echo "${0##*/}: unable to detect a version; pass --force to output the contents unchanged" >&2
  exit 1
fi
